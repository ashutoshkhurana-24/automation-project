# dependencies — restored with `npm install`
node_modules/

# runtime state — your saved scenes, auto-seeded on first run if absent
scenes.json

# macOS
.DS_Store

# editor
.vscode/
.idea/
*.swp

# deploy bundle (rebuild with ./build-bundle.sh)
dashboard-nas-bundle.tar.gz

# runtime state written by the server
settings.json
state.json

# your backdrop photo — personal, and per-install
data/background.jpg

# generated by tools/make-icon.js
data/icon-*.png

# runtime state — your schedules
schedules.json

# the Android shell: the project is source, its build output is not
android-app/node_modules/
android-app/android/build/
android-app/android/app/build/
android-app/android/.gradle/
android-app/android/local.properties
android-app/android/capacitor-cordova-android-plugins/

# the built APK — rebuild with android-app/
the-house.apk

# Pairing keys for the televisions: per-install, and a credential.
data/tv-keys.json

# The televisions app lists: a cache, rebuilt from the sets themselves.
data/tv-apps.json

# per-install settings: this house's name, hub address, televisions, groups.
# config.example.json is the committed shape; setup writes this one.
config.json

# first-run cues, per-install: a cue is a list of record_ids and those numbers
# mean a different lamp on a different hub.
data/seed-scenes.json

# The spoken-command model key. A credential, and per-install. Not in
# config.json because /setup rewrites that from its form and has no field for
# this, so it would be dropped on the next save.
data/openai-key

# The house's own history, behind the monthly report. Per-install, and it is a
# record of when people were in which room — not something to commit.
data/history/

# Cortex Code's own plan files. Working notes from the agent, not the project's.
.cortex/
